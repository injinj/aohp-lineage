diff --git a/src/wlserver.cpp b/src/wlserver.cpp
index 2d73927..53e5e2d 100644
--- a/src/wlserver.cpp
+++ b/src/wlserver.cpp
@@ -25,10 +25,12 @@
 #include "wlr_begin.hpp"
 #include <wlr/backend.h>
 #include <wlr/backend/headless.h>
-#if HAVE_DRM
 #include <wlr/backend/libinput.h>
-#endif
+#include <libinput.h>
+#include <libudev.h>
 #include <wlr/backend/multi.h>
+#include <wlr/types/wlr_linux_dmabuf_v1.h>
+#include <wlr/render/drm_format_set.h>
 #include <wlr/interfaces/wlr_keyboard.h>
 #include <wlr/render/wlr_renderer.h>
 #include <wlr/types/wlr_compositor.h>
@@ -1989,6 +1991,28 @@ bool wlserver_init( void ) {
 
 	wlr_renderer_init_wl_display(wlserver.wlr.renderer, wlserver.display);
 
+	// AOHP/KGSL: turnip on /dev/kgsl-3d0 has no DRM render node (no VK_EXT_physical_device_drm), so
+	// wlr_renderer_init_wl_display() skips zwp_linux_dmabuf_v1 and every Vulkan/EGL client is then unable to
+	// create a swapchain. Buffer sharing itself works (dma-buf export/import via the kgsl ION path), so
+	// advertise linux-dmabuf v3 (no feedback / no main device needed) with the renderer's dmabuf formats.
+	if ( wlr_renderer_get_drm_fd( wlserver.wlr.renderer ) < 0 )
+	{
+		const struct wlr_drm_format_set *fmts = wlr_renderer_get_texture_formats( wlserver.wlr.renderer, WLR_BUFFER_CAP_DMABUF );
+		if ( fmts )
+		{
+			struct wlr_linux_dmabuf_feedback_v1 feedback = {0};
+			wl_array_init( &feedback.tranches );
+			struct wlr_linux_dmabuf_feedback_v1_tranche *tranche = wlr_linux_dmabuf_feedback_add_tranche( &feedback );
+			tranche->target_device = 0;
+			tranche->formats = *fmts;
+			if ( wlr_linux_dmabuf_v1_create( wlserver.display, 3, &feedback ) )
+				wl_log.infof( "linux-dmabuf v3 created without a DRM device (KGSL)" );
+			else
+				wl_log.errorf( "linux-dmabuf creation without a DRM device failed" );
+			wl_array_release( &feedback.tranches );
+		}
+	}
+
 	wlserver.wlr.compositor = wlr_compositor_create(wlserver.display, 5, wlserver.wlr.renderer);
 
 	wl_signal_add( &wlserver.wlr.compositor->events.new_surface, &new_surface_listener );
